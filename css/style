:root {
    color-scheme: dark;
    --bg: #101812;
    --surface: #19231c;
    --surface-raised: #202c23;
    --text: #f4f4eb;
    --muted: #a0aa9e;
    --accent: #c4f46b;
    --accent-dark: #233510;
    --line: rgba(235, 243, 229, .12);
    --font-body: "DM Sans", sans-serif;
    --font-display: "Manrope", sans-serif;
}

* { box-sizing: border-box; }

html { min-width: 320px; background: var(--bg); }

body {
    margin: 0;
    min-height: 100vh;
    color: var(--text);
    background:
        radial-gradient(ellipse at 82% 25%, rgba(86, 118, 54, .17), transparent 34rem),
        radial-gradient(ellipse at 14% 75%, rgba(55, 87, 58, .12), transparent 30rem),
        var(--bg);
    font-family: var(--font-body);
    -webkit-font-smoothing: antialiased;
}

a { color: inherit; }

.page-shell { width: min(1120px, calc(100% - 64px)); margin: 0 auto; }

.topbar {
    height: 88px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid var(--line);
}

.brand {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    font: 800 24px/1 var(--font-display);
    letter-spacing: -1.5px;
    text-decoration: none;
}

.brand-mark {
    display: grid;
    width: 35px;
    height: 35px;
    place-items: center;
    border-radius: 11px;
    color: var(--bg);
    background: var(--accent);
}

.brand-mark svg { width: 25px; height: 25px; }
.brand-period { color: var(--accent); }

.topbar-note, .back-link {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    color: var(--muted);
    font-size: 13px;
    text-decoration: none;
}

.back-link:hover { color: var(--accent); }
.status-dot, .music-live span { width: 7px; height: 7px; border-radius: 50%; background: var(--accent); }

.hero {
    min-height: 586px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: 38px;
    padding: 66px 0 75px;
}

.hero-copy { position: relative; z-index: 1; }
.eyebrow { display: inline-flex; align-items: center; gap: 10px; color: var(--accent); font-size: 11px; font-weight: 700; letter-spacing: 1.8px; text-transform: uppercase; }
.eyebrow-line { width: 24px; height: 1px; background: var(--accent); }

h1, h2, h3, p { margin-top: 0; }
.hero h1, .travel-intro h1 {
    margin: 24px 0 19px;
    font: 700 clamp(46px, 5.5vw, 68px)/1.08 var(--font-display);
    letter-spacing: -3.4px;
}

.hero h1 span, .travel-intro h1 span { color: var(--accent); }
.hero-description { max-width: 455px; margin-bottom: 30px; color: var(--muted); font-size: 16px; line-height: 1.75; }
.button { min-height: 54px; display: inline-flex; align-items: center; justify-content: center; gap: 13px; border: 0; border-radius: 9px; font: 700 14px var(--font-body); text-decoration: none; transition: background .2s ease, transform .2s ease, box-shadow .2s ease; cursor: pointer; }
.button-primary { color: #172010; background: var(--accent); box-shadow: 0 8px 26px rgba(153, 205, 76, .12); }
.button-primary:hover { background: #d3ff80; box-shadow: 0 10px 32px rgba(153, 205, 76, .2); transform: translateY(-2px); }
.button-primary:focus-visible, .button-youtube:focus-visible, .back-link:focus-visible, .brand:focus-visible { outline: 2px solid #fff; outline-offset: 4px; }
.button-start { padding: 0 22px; }
.button-start svg, .button-arrow { width: 19px; height: 19px; }
.provider-buttons { display: flex; flex-direction: column; align-items: flex-start; gap: 11px; }
.button-youtube { padding: 0 17px; border: 1px solid rgba(235, 243, 229, .18); color: var(--text); background: rgba(32, 44, 35, .68); }
.button-youtube:hover { border-color: rgba(235, 243, 229, .38); background: #26342a; transform: translateY(-2px); }
.youtube-play { display: grid; width: 22px; height: 22px; place-items: center; border-radius: 6px; color: #fff; background: #e62117; }
.youtube-play svg { width: 15px; height: 15px; }
.privacy-note { display: flex; align-items: center; gap: 7px; margin: 16px 0 0; color: #899487; font-size: 11px; }
.privacy-note svg, .card-footnote svg { width: 14px; height: 14px; flex: 0 0 auto; }

.notice { margin: 16px 0 0; color: #ffc0af; font-size: 13px; }
[hidden] { display: none !important; }

.hero-art { position: relative; min-height: 388px; display: grid; place-items: center; }
.art-glow { position: absolute; width: 330px; height: 250px; border-radius: 50%; background: rgba(139, 184, 72, .12); filter: blur(60px); }
.orbit { position: absolute; border: 1px solid rgba(202, 230, 177, .08); border-radius: 50%; transform: rotate(-23deg); }
.orbit-one { width: 475px; height: 235px; }
.orbit-two { width: 390px; height: 310px; transform: rotate(38deg); }
.music-card { position: relative; z-index: 1; width: min(410px, 88%); padding: 24px; border: 1px solid rgba(236, 246, 229, .1); border-radius: 16px; background: linear-gradient(145deg, rgba(38, 51, 40, .98), rgba(25, 35, 28, .98)); box-shadow: 0 25px 80px rgba(0, 0, 0, .35); transform: rotate(-2deg); }
.music-card-top, .time-labels { display: flex; align-items: center; justify-content: space-between; }
.music-label { color: #9da99c; font-size: 9px; font-weight: 700; letter-spacing: 1.4px; }
.music-live { display: flex; align-items: center; gap: 6px; color: var(--accent); font-size: 8px; font-weight: 700; letter-spacing: 1px; }
.music-live span { width: 5px; height: 5px; }
.route-preview { position: relative; display: flex; flex-direction: column; gap: 0; margin: 26px 0 24px 4px; }
.route-point { display: flex; align-items: center; gap: 13px; min-height: 29px; color: #e6e9df; font-size: 12px; }
.route-point:last-child { margin-top: 15px; }
.route-pin { width: 9px; height: 9px; border: 2px solid var(--accent); border-radius: 50%; }
.route-pin-end { border-color: #e0b878; border-radius: 2px; transform: rotate(45deg); }
.route-dash { position: absolute; top: 26px; left: 4px; height: 17px; border-left: 1px dashed rgba(216, 229, 204, .4); }
.now-playing { display: flex; align-items: center; gap: 13px; padding: 13px; border: 1px solid rgba(232, 241, 225, .08); border-radius: 10px; background: rgba(11, 17, 12, .4); }
.album-art { display: grid; width: 48px; height: 48px; flex: 0 0 auto; place-items: center; border-radius: 7px; background: linear-gradient(145deg, #8b9b45, #426453 55%, #26384b); }
.equalizer { display: flex; align-items: center; gap: 3px; height: 20px; }
.equalizer i { width: 3px; border-radius: 3px; background: var(--accent); animation: equalize .85s ease-in-out infinite alternate; }
.equalizer i:nth-child(1) { height: 9px; animation-delay: -.6s; }
.equalizer i:nth-child(2) { height: 19px; animation-delay: -.3s; }
.equalizer i:nth-child(3) { height: 13px; animation-delay: -.7s; }
.equalizer i:nth-child(4) { height: 7px; animation-delay: -.2s; }
@keyframes equalize { to { transform: scaleY(.45); } }
.track-copy { display: flex; flex: 1; flex-direction: column; gap: 5px; }
.track-title { font-size: 12px; font-weight: 700; }
.track-subtitle { color: var(--muted); font-size: 10px; }
.play-icon { display: grid; width: 30px; height: 30px; place-items: center; border-radius: 50%; color: var(--bg); background: var(--accent); }
.play-icon svg { width: 16px; height: 16px; }
.progress-track { height: 3px; margin-top: 16px; overflow: hidden; border-radius: 3px; background: rgba(233, 241, 224, .13); }
.progress-track span { display: block; width: 38%; height: 100%; border-radius: inherit; background: var(--accent); }
.time-labels { margin-top: 7px; color: #859183; font-size: 9px; }
.floating-note { position: absolute; z-index: 2; display: flex; align-items: center; gap: 8px; padding: 10px 13px; border: 1px solid rgba(233, 243, 225, .1); border-radius: 9px; color: #e8ede2; background: #222e24; box-shadow: 0 12px 30px rgba(0, 0, 0, .25); font-size: 10px; }
.note-top { top: 24px; right: 4px; }
.note-bottom { bottom: 28px; left: -3px; }
.note-icon, .note-spark { color: var(--accent); font-size: 15px; }

.how-it-works { padding: 36px 0 48px; border-top: 1px solid var(--line); }
.section-heading { text-align: center; }
.section-heading .eyebrow { justify-content: center; }
.section-heading h2 { margin: 13px 0 34px; font: 650 26px var(--font-display); letter-spacing: -1px; }
.steps { display: grid; grid-template-columns: repeat(3, 1fr); gap: 32px; }
.step { display: flex; gap: 16px; }
.step-number { color: var(--accent); font: 700 13px var(--font-display); }
.step h3 { margin: 0 0 8px; font: 650 14px var(--font-display); }
.step p { max-width: 260px; margin: 0; color: var(--muted); font-size: 12px; line-height: 1.7; }
.footer { min-height: 63px; display: flex; align-items: center; justify-content: space-between; border-top: 1px solid var(--line); color: #879183; font-size: 11px; }
.footer .brand-period { font-size: 8px; }
.footer-meta { display: flex; align-items: center; gap: 18px; }
.footer-meta a { color: inherit; text-decoration: none; }
.footer-meta a:hover { color: var(--accent); }

.travel-layout { min-height: calc(100vh - 152px); display: grid; grid-template-columns: 1fr 1fr; align-items: center; gap: 88px; padding: 62px 0; }
.travel-intro h1 { font-size: clamp(46px, 5vw, 62px); }
.travel-intro > p { max-width: 405px; color: var(--muted); font-size: 15px; line-height: 1.8; }
.travel-assurance { display: flex; align-items: center; gap: 13px; margin-top: 37px; color: var(--muted); font-size: 11px; line-height: 1.65; }
.travel-assurance strong { color: var(--text); font-size: 12px; }
.assurance-icon { display: grid; width: 41px; height: 41px; place-items: center; border: 1px solid rgba(196, 244, 107, .22); border-radius: 11px; color: var(--accent); background: rgba(196, 244, 107, .07); font-size: 22px; }
.travel-card { padding: 32px; border: 1px solid var(--line); border-radius: 16px; background: linear-gradient(145deg, rgba(31, 43, 34, .96), rgba(23, 32, 25, .96)); box-shadow: 0 24px 70px rgba(0, 0, 0, .2); }
.card-heading { display: flex; align-items: center; gap: 13px; margin-bottom: 29px; }
.card-icon { display: grid; width: 43px; height: 43px; place-items: center; border-radius: 12px; color: var(--accent); background: rgba(196, 244, 107, .1); }
.card-icon svg { width: 23px; height: 23px; }
.card-heading h2 { margin: 0 0 4px; font: 700 18px var(--font-display); }
.card-heading p { margin: 0; color: var(--muted); font-size: 12px; }
.field-label { display: block; margin-bottom: 9px; color: #dce3d8; font-size: 12px; font-weight: 600; }
.input-wrap { position: relative; }
.input-wrap input { width: 100%; height: 52px; padding: 0 14px 0 40px; border: 1px solid rgba(232, 241, 225, .13); border-radius: 8px; outline: none; color: var(--text); background: rgba(8, 14, 9, .28); font: 13px var(--font-body); transition: border-color .2s ease, box-shadow .2s ease; }
.input-wrap input::placeholder { color: #788375; }
.input-wrap input:focus { border-color: rgba(196, 244, 107, .68); box-shadow: 0 0 0 3px rgba(196, 244, 107, .1); }
.input-marker { position: absolute; top: 50%; left: 15px; width: 10px; height: 10px; border: 2px solid var(--accent); border-radius: 50%; transform: translateY(-50%); }
.marker-end { border-color: #e0b878; border-radius: 2px; transform: translateY(-50%) rotate(45deg); }
.route-connector { height: 23px; margin-left: 19px; border-left: 1px dashed rgba(215, 228, 205, .35); }
.button-submit { width: 100%; justify-content: center; margin-top: 24px; }
.button-submit svg { position: absolute; }
.button-submit { position: relative; }
.button-submit .button-arrow { right: 18px; }
.button-spinner { display: none; width: 17px; height: 17px; border: 2px solid rgba(23, 32, 16, .28); border-top-color: #172010; border-radius: 50%; animation: spin .7s linear infinite; }
.button-submit.is-loading .button-spinner { display: inline-block; }
.button-submit.is-loading .button-arrow { display: none; }
.button-submit:disabled { cursor: wait; opacity: .8; }
@keyframes spin { to { transform: rotate(360deg); } }
.form-message { margin: 15px 0 0; color: #ffc0af; font-size: 12px; line-height: 1.6; }
.form-message.is-success { color: var(--accent); }
.card-footnote { display: flex; align-items: center; justify-content: center; gap: 7px; margin: 17px 0 0; color: #879183; font-size: 10px; }

@media (max-width: 760px) {
    .page-shell { width: min(100% - 40px, 560px); }
    .topbar { height: 72px; }
    .topbar-note { font-size: 0; }
    .hero { min-height: auto; grid-template-columns: 1fr; gap: 17px; padding: 57px 0 42px; }
    .hero h1 { font-size: clamp(45px, 11vw, 62px); }
    .hero-description { max-width: 500px; font-size: 14px; }
    .hero-art { min-height: 335px; margin: 0 -12px; }
    .art-glow { width: min(280px, calc(100vw - 48px)); }
    .music-card { width: min(390px, 88%); }
    .orbit-one { width: min(320px, calc(100vw - 80px)); height: 210px; }
    .orbit-two { width: min(260px, calc(100vw - 140px)); height: 280px; }
    .note-top { right: 1px; }
    .note-bottom { left: 0; }
    .how-it-works { padding-top: 30px; }
    .steps { grid-template-columns: 1fr; gap: 21px; max-width: 400px; margin: 0 auto; }
    .step p { max-width: none; }
    .section-heading h2 { font-size: 22px; }
    .travel-layout { min-height: auto; grid-template-columns: 1fr; gap: 37px; padding: 49px 0; }
    .travel-intro h1 { margin-top: 19px; font-size: 52px; }
    .travel-intro > p { max-width: 520px; font-size: 14px; }
    .travel-assurance { margin-top: 22px; }
    .travel-card { padding: 25px 21px; }
    .footer { min-height: 57px; gap: 12px; font-size: 9px; }
}

@media (max-width: 380px) {
    .page-shell { width: calc(100% - 32px); }
    .hero h1 { font-size: 43px; letter-spacing: -2.5px; }
    .travel-intro h1 { font-size: 45px; }
    .music-card { width: 92%; padding: 19px; }
    .floating-note { font-size: 9px; }
    .note-bottom { bottom: 13px; }
}

@media (prefers-reduced-motion: reduce) {
    *, *::before, *::after { scroll-behavior: auto !important; animation-duration: .01ms !important; animation-iteration-count: 1 !important; transition-duration: .01ms !important; }
}
